[run]
branch = True
source = 
    codex
    dsl
    loader
omit =
    */tests/*
    */scripts/*
    */__init__.py
    loader/*

[report]
show_missing = True
precision = 2
skip_covered = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.
    def __repr__
    def __str__
    @property
    @abstractmethod
